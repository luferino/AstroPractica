---
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;	// Define any props you want to pass to the layout here
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link href="/src/styles/global.css" rel="stylesheet" />
		<title>{title}</title>
		<ClientRouter /> <!-- This enables client-side routing for the entire layout -->
	</head>
	<body>
		<div>
			<slot />
		</div>
		
	</body>
</html>

<style is:global>
	@reference 'tailwindcss';
	html{
		font-family: sans-serif,system-ui;
		background: #13151a;
		color: #fff;
	}
	body {
		@apply grid min-h-screen place-content-center p-20;
	}
	body > div {
		@apply container;
	}
</style>
